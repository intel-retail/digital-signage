        </mxCell>
        <mxCell id="sec_leg_title" value="Legend" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1480" y="75" width="150" height="20" as="geometry" />
        </mxCell>
        <mxCell id="sec_leg1" value="Untrusted / External" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#c62828;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1495" y="103" width="120" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sec_leg2" value="Entry Point (TLS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1495" y="141" width="120" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sec_leg3" value="Internal / Trusted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1495" y="179" width="120" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sec_leg4" value="Data Store" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1495" y="217" width="120" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sec_leg5" value="Encrypted flow" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#c62828;strokeWidth=2;fontSize=10;endArrow=block;" edge="1" parent="1">
          <mxGeometry x="1495" y="256" width="120" height="28" relative="1" as="geometry">
            <mxPoint x="1495" y="269" as="sourcePoint" />
            <mxPoint x="1615" y="269" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sec_leg6" value="Plaintext flow" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2e7d32;strokeWidth=2;fontSize=10;dashed=1;endArrow=block;" edge="1" parent="1">
          <mxGeometry x="1495" y="295" width="120" height="28" relative="1" as="geometry">
            <mxPoint x="1495" y="308" as="sourcePoint" />
            <mxPoint x="1615" y="308" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sec_leg6b" value="Read-only mount" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;strokeWidth=1;fontSize=10;dashed=1;endArrow=open;" edge="1" parent="1">
          <mxGeometry x="1495" y="335" width="120" height="28" relative="1" as="geometry">
            <mxPoint x="1495" y="348" as="sourcePoint" />
            <mxPoint x="1615" y="348" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- SECURITY NOTES PANEL                                         -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <mxCell id="sec_notes" value="&lt;b&gt;Security Considerations&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Exposed Host Ports:&lt;/b&gt;&lt;br/&gt;• TCP 5000 – HTTPS (nginx)&lt;br/&gt;• UDP/TCP 3478 – TURN (COTURN)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Internal-only Ports:&lt;/b&gt;&lt;br/&gt;• TCP 1883 – MQTT (no auth)&lt;br/&gt;• TCP 8080 – DL Streamer REST&lt;br/&gt;• TCP 8889 – MediaMTX WebRTC&lt;br/&gt;• TCP 5003 – AIG Server REST&lt;br/&gt;• TCP 8000 – ChromaDB (no auth)&lt;br/&gt;• TCP 5000 – Web UI HTTP&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Recommendations:&lt;/b&gt;&lt;br/&gt;• Replace self-signed cert with CA-signed&lt;br/&gt;• Enable MQTT password auth&lt;br/&gt;• Add ChromaDB API token&lt;br/&gt;• Run containers as non-root&lt;br/&gt;• Mount volumes read-only where possible&lt;br/&gt;• Rotate TURN shared secret regularly" style="text;html=1;strokeColor=#b0bec5;fillColor=#eceff1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#37474f;" vertex="1" parent="1">
          <mxGeometry x="1480" y="400" width="150" height="400" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- TRUST BOUNDARY: EXTERNAL / UNTRUSTED                        -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <mxCell id="sec_ext_zone" value="&lt;b&gt;External / Untrusted Zone&lt;/b&gt;" style="swimlane;fillColor=#ffebee;strokeColor=#c62828;fontSize=11;fontStyle=1;startSize=25;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="530" height="170" as="geometry" />
        </mxCell>

        <!-- Browser -->
        <mxCell id="sec_browser" value="&lt;b&gt;Browser / Display Client&lt;/b&gt;&lt;br/&gt;Digital Signage Screen" style="shape=mxgraph.cisco.computers_and_peripherals.pc;fillColor=#ffcdd2;strokeColor=#c62828;html=1;fontSize=11;align=center;" vertex="1" parent="sec_ext_zone">
          <mxGeometry x="30" y="40" width="140" height="110" as="geometry" />
        </mxCell>

        <!-- Exposed ports annotation inside external zone -->
        <mxCell id="sec_exposed_ports" value="&lt;b&gt;Exposed to Host Network:&lt;/b&gt;&lt;br/&gt;TCP :5000  HTTPS (nginx)&lt;br/&gt;UDP/TCP :3478  TURN relay (COTURN)" style="text;html=1;strokeColor=#c62828;fillColor=#ffcdd2;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=10;" vertex="1" parent="sec_ext_zone">
          <mxGeometry x="200" y="40" width="300" height="80" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- TRUST BOUNDARY: ENTRY POINT (TLS)                           -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <mxCell id="sec_entry_zone" value="&lt;b&gt;Entry Point — TLS Termination&lt;/b&gt;" style="swimlane;fillColor=#fffde7;strokeColor=#f57f17;fontSize=11;fontStyle=1;startSize=25;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="620" y="70" width="800" height="170" as="geometry" />
        </mxCell>

        <!-- nginx -->
        <mxCell id="sec_nginx" value="&lt;b&gt;nginx Reverse Proxy&lt;/b&gt;&lt;br/&gt;TLS 1.3 · Self-signed cert&lt;br/&gt;&lt;font color=&quot;#888888&quot;&gt;Terminates HTTPS; forwards HTTP internally&lt;/font&gt;&lt;br/&gt;HTTPS :5000 → HTTP :5000 (Web UI)&lt;br/&gt;HTTPS /aig-api/ → HTTP :5003 (AIG Server)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;fontSize=11;arcSize=8;" vertex="1" parent="sec_entry_zone">
          <mxGeometry x="20" y="40" width="380" height="110" as="geometry" />
        </mxCell>

        <!-- COTURN -->
        <mxCell id="sec_coturn_entry" value="&lt;b&gt;COTURN TURN Server&lt;/b&gt;&lt;br/&gt;UDP/TCP :3478 exposed to host&lt;br/&gt;&lt;font color=&quot;#888888&quot;&gt;Shared-secret HMAC auth (time-limited tokens)&lt;/font&gt;&lt;br/&gt;ICE relay for WebRTC peer connections" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;fontSize=11;arcSize=8;" vertex="1" parent="sec_entry_zone">
          <mxGeometry x="420" y="40" width="360" height="110" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- DOCKER BRIDGE NETWORK (INTERNAL / TRUSTED)                  -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <mxCell id="sec_docker_net" value="&lt;b&gt;Docker Bridge Network — app_network (Internal / Isolated)&lt;/b&gt;" style="swimlane;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=11;fontStyle=1;startSize=25;arcSize=4;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="1400" height="620" as="geometry" />
        </mxCell>

        <!-- ─── VIDEO STREAMING GROUP ──────────────────────────────── -->
        <mxCell id="sec_grp_video" value="&lt;b&gt;Video Streaming&lt;/b&gt;" style="swimlane;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=11;fontStyle=1;startSize=25;arcSize=4;" vertex="1" parent="sec_docker_net">
          <mxGeometry x="20" y="40" width="360" height="540" as="geometry" />
        </mxCell>

        <mxCell id="sec_mediamtx" value="&lt;b&gt;MediaMTX&lt;/b&gt;&lt;br/&gt;RTSP ingress · WebRTC egress&lt;br/&gt;&lt;font color=&quot;#888888&quot;&gt;Internal: TCP :8889 (WHIP/WHEP)&lt;/font&gt;&lt;br/&gt;No TLS on internal RTSP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;" vertex="1" parent="sec_grp_video">
          <mxGeometry x="30" y="50" width="300" height="95" as="geometry" />
        </mxCell>

        <mxCell id="sec_coturn_int" value="&lt;b&gt;COTURN (internal)&lt;/b&gt;&lt;br/&gt;Shared-secret HMAC token auth&lt;br/&gt;&lt;font color=&quot;#888888&quot;&gt;Internal: UDP/TCP :3478&lt;/font&gt;&lt;br/&gt;Port :3478 also exposed to host" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;" vertex="1" parent="sec_grp_video">
          <mxGeometry x="30" y="175" width="300" height="95" as="geometry" />
        </mxCell>

        <mxCell id="sec_dlstreamer" value="&lt;b&gt;DL Streamer Pipeline Server&lt;/b&gt;&lt;br/&gt;YOLO object detection pipeline&lt;br/&gt;&lt;font color=&quot;#888888&quot;&gt;Internal: REST TCP :8080&lt;/font&gt;&lt;br/&gt;Not exposed to host" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;arcSize=8;" vertex="1" parent="sec_grp_video">
          <mxGeometry x="30" y="300" width="300" height="95" as="geometry" />
        </mxCell>

        <!-- Camera note -->
        <mxCell id="sec_camera_note" value="&lt;b&gt;IP Camera&lt;/b&gt; (external)&lt;br/&gt;RTSP stream ingested by DL Streamer&lt;br/&gt;Network-level trust required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#c62828;fontSize=11;arcSize=8;" vertex="1" parent="sec_grp_video">
          <mxGeometry x="30" y="420" width="300" height="80" as="geometry" />
        </mxCell>

        <!-- ─── CORE SERVICES ─────────────────────────────────────── -->
        <mxCell id="sec_grp_core" value="&lt;b&gt;Core Services&lt;/b&gt;" style="swimlane;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=11;fontStyle=1;startSize=25;arcSize=4;" vertex="1" parent="sec_docker_net">
          <mxGeometry x="420" y="40" width="360" height="370" as="geometry" />
        </mxCell>

        <mxCell id="sec_webui_int" value="&lt;b&gt;Web UI&lt;/b&gt;&lt;br/&gt;Flask · MQTT subscriber · Ad engine&lt;br/&gt;&lt;font color=&quot;#888888&quot;&gt;Internal: HTTP TCP :5000 (plaintext)&lt;/font&gt;&lt;br/&gt;Reached externally via nginx TLS proxy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;" vertex="1" parent="sec_grp_core">
          <mxGeometry x="30" y="50" width="300" height="95" as="geometry" />
        </mxCell>

        <mxCell id="sec_mqtt_int" value="&lt;b&gt;Mosquitto MQTT Broker&lt;/b&gt;&lt;br/&gt;Topic: yolo_od_results&lt;br/&gt;&lt;font color=&quot;#c62828&quot;&gt;⚠ Internal: TCP :1883 — no authentication&lt;/font&gt;&lt;br/&gt;Not exposed to host; trusted by network isolation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;arcSize=8;" vertex="1" parent="sec_grp_core">
          <mxGeometry x="30" y="175" width="300" height="95" as="geometry" />
        </mxCell>

        <!-- ─── AI SERVICES GROUP ─────────────────────────────────── -->
        <mxCell id="sec_grp_ai" value="&lt;b&gt;AI / Ad Services&lt;/b&gt;" style="swimlane;fillColor=#f1f8e9;strokeColor=#558b2f;fontSize=11;fontStyle=1;startSize=25;arcSize=4;" vertex="1" parent="sec_docker_net">
          <mxGeometry x="830" y="40" width="540" height="370" as="geometry" />
        </mxCell>

        <mxCell id="sec_aig" value="&lt;b&gt;AIG Server&lt;/b&gt; (Flask-RESTX)&lt;br/&gt;OpenVINO GenAI · SDXL-Turbo · ASE (Sentence-Transformers)&lt;br/&gt;&lt;font color=&quot;#888888&quot;&gt;Internal: HTTP TCP :5003 (plaintext)&lt;/font&gt;&lt;br/&gt;Reached externally via nginx /aig-api/ proxy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;arcSize=8;" vertex="1" parent="sec_grp_ai">
          <mxGeometry x="30" y="50" width="480" height="95" as="geometry" />
        </mxCell>

        <mxCell id="sec_chromadb" value="&lt;b&gt;ChromaDB&lt;/b&gt;&lt;br/&gt;Vector store for predefined ads&lt;br/&gt;&lt;font color=&quot;#c62828&quot;&gt;⚠ Internal: HTTP TCP :8000 — no authentication&lt;/font&gt;&lt;br/&gt;Not exposed to host; trusted by network isolation" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="sec_grp_ai">
          <mxGeometry x="110" y="175" width="320" height="95" as="geometry" />
        </mxCell>

        <!-- ─── HOST VOLUMES ─────────────────────────────────────── -->
        <mxCell id="sec_host_vols" value="&lt;b&gt;Host Filesystem — Volume Mounts&lt;/b&gt;" style="swimlane;fillColor=#fffde7;strokeColor=#d6b656;fontSize=11;fontStyle=1;startSize=25;arcSize=4;dashed=1;" vertex="1" parent="sec_docker_net">
          <mxGeometry x="20" y="480" width="1350" height="120" as="geometry" />
        </mxCell>

        <mxCell id="sec_csv_vol" value="&lt;b&gt;ProductAssociations.csv&lt;/b&gt;&lt;br/&gt;Products · prices · promos&lt;br/&gt;Mounted read/write" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="sec_host_vols">
          <mxGeometry x="30" y="35" width="230" height="70" as="geometry" />
        </mxCell>

        <mxCell id="sec_ads_vol" value="&lt;b&gt;pre-defined-ads/&lt;/b&gt;&lt;br/&gt;JPEG images for provisioned products&lt;br/&gt;Mounted read/write" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="sec_host_vols">
          <mxGeometry x="290" y="35" width="230" height="70" as="geometry" />
        </mxCell>

        <mxCell id="sec_model_vol" value="&lt;b&gt;aig/models/&lt;/b&gt;&lt;br/&gt;SDXL-Turbo OV int8 · MiniLM-L12-v2&lt;br/&gt;Mounted read-only (recommended)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="sec_host_vols">
          <mxGeometry x="550" y="35" width="230" height="70" as="geometry" />
        </mxCell>

        <mxCell id="sec_chroma_vol" value="&lt;b&gt;chroma_data/&lt;/b&gt;&lt;br/&gt;ChromaDB persistent storage&lt;br/&gt;Mounted read/write" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="sec_host_vols">
          <mxGeometry x="810" y="35" width="230" height="70" as="geometry" />
        </mxCell>

        <mxCell id="sec_cert_vol" value="&lt;b&gt;nginx/certs/&lt;/b&gt;&lt;br/&gt;TLS certificate + private key&lt;br/&gt;Mounted read-only" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="sec_host_vols">
          <mxGeometry x="1070" y="35" width="230" height="70" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- EDGES / DATA FLOWS                                           -->
        <!-- ═══════════════════════════════════════════════════════════ -->

        <!-- Browser → nginx (HTTPS encrypted) -->
        <mxCell id="sec_e_browser_nginx" value="HTTPS :5000 (TLS 1.3)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#c62828;strokeWidth=2;fontStyle=0;fontSize=10;" edge="1" source="sec_browser" target="sec_nginx" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="110" y="185" />
              <mxPoint x="110" y="200" />
              <mxPoint x="810" y="200" />
              <mxPoint x="810" y="185" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Browser → COTURN (ICE relay) -->
        <mxCell id="sec_e_browser_coturn" value="ICE/TURN relay (UDP :3478)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#f57f17;strokeWidth=2;fontStyle=0;fontSize=10;dashed=1;" edge="1" source="sec_browser" target="sec_coturn_entry" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="200" y="185" />
              <mxPoint x="200" y="220" />
              <mxPoint x="1200" y="220" />
              <mxPoint x="1200" y="185" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- nginx → Web UI (HTTP internal plaintext) -->
        <mxCell id="sec_e_nginx_webui" value="HTTP :5000 (plaintext internal)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2e7d32;strokeWidth=2;fontStyle=0;fontSize=10;dashed=1;" edge="1" source="sec_nginx" target="sec_webui_int" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="810" y="250" />
              <mxPoint x="700" y="250" />
              <mxPoint x="700" y="380" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- nginx → AIG Server (HTTP internal plaintext) -->
        <mxCell id="sec_e_nginx_aig" value="HTTP :5003 (plaintext internal)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2e7d32;strokeWidth=2;fontStyle=0;fontSize=10;dashed=1;" edge="1" source="sec_nginx" target="sec_aig" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1020" y="250" />
              <mxPoint x="1390" y="250" />
              <mxPoint x="1390" y="400" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- nginx → MediaMTX (WebRTC WHIP/WHEP) -->
        <mxCell id="sec_e_nginx_mtx" value="WebRTC WHIP/WHEP :8889" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2e7d32;strokeWidth=2;fontStyle=0;fontSize=10;dashed=1;" edge="1" source="sec_nginx" target="sec_mediamtx" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="810" y="260" />
              <mxPoint x="430" y="260" />
              <mxPoint x="430" y="370" />
              <mxPoint x="100" y="370" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- MQTT internal flow: DL Streamer → MQTT → Web UI -->
        <mxCell id="sec_e_dls_mqtt" value="MQTT publish (TCP :1883, no auth)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;strokeWidth=2;fontStyle=0;fontSize=10;dashed=1;" edge="1" source="sec_dlstreamer" target="sec_mqtt_int" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="430" y="620" />
              <mxPoint x="570" y="620" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="sec_e_mqtt_webui" value="MQTT subscribe" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;strokeWidth=2;fontStyle=0;fontSize=10;dashed=1;" edge="1" source="sec_mqtt_int" target="sec_webui_int" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Web UI → AIG (HTTP :5003) -->
        <mxCell id="sec_e_webui_aig" value="HTTP REST (plaintext internal)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2e7d32;strokeWidth=2;fontStyle=0;fontSize=10;dashed=1;" edge="1" source="sec_webui_int" target="sec_aig" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="810" y="400" />
              <mxPoint x="880" y="400" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- AIG → ChromaDB -->
        <mxCell id="sec_e_aig_chroma" value="HTTP REST (plaintext, no auth)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;strokeWidth=2;fontStyle=0;fontSize=10;dashed=1;" edge="1" source="sec_aig" target="sec_chromadb" parent="1">
