        <!-- ═══════════════════════════════════════════════════════════ -->
        <mxCell id="sec_leg_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
