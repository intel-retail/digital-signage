          <mxGeometry x="420" y="650" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ann3" value="③ Ad delivery:&#xa;Predefined ad (ChromaDB) → fallback → Dynamic GenAI" style="text;html=1;strokeColor=#cccccc;fillColor=#ffffff;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="780" y="650" width="310" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ann4" value="④ Browser:&#xa;HTTPS → nginx → Web UI (ad + WebRTC video)" style="text;html=1;strokeColor=#cccccc;fillColor=#ffffff;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="1130" y="650" width="270" height="50" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="security" name="Security Architecture">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
