        <mxCell id="sec_title" value="Intel® Digital Signage – Security Architecture (Docker Deployment)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#0071C5;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="1220" height="40" as="geometry" />
